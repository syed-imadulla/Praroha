# Multi-stage minimal Dockerfile for PRAROHA Dedicated Cinematic Rendering Worker (Phase 48)
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system utilities and FFmpeg (minimal dependencies, no Chromium, no X11)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Python worker dependencies (no FastAPI, no Uvicorn)
COPY backend/requirements-worker.txt /app/backend/requirements-worker.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-worker.txt

# Create non-root user and scratch/uploads directories
RUN useradd -u 1001 -m -s /bin/bash appuser && \
    mkdir -p /app/scratch /app/uploads && \
    chown -R appuser:appuser /app

# Copy backend application source with correct ownership
COPY --chown=appuser:appuser backend /app/backend

USER appuser

# Run as standalone worker (supports CLI arguments or default --server for ACA scale-to-zero)
ENTRYPOINT ["python", "-m", "backend.app.workers.cinematic_worker"]
CMD ["--server"]

