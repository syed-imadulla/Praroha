# ==============================================================================
# PRAROHA — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application
PROJECT_NAME="PRAROHA — Seed to Universe"
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 1. AI Generative Provider (Gemini)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Connect to Supabase Postgres, Neon, AWS RDS, or Docker Postgres.
# Schema is automatically verified and initialized on startup via SQLModel.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# ------------------------------------------------------------------------------
# 3. Object Storage (Supabase Storage)
# ------------------------------------------------------------------------------
# Used for persistent durable storage of character voices, concept art, atmospheric audio, and video.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]
SUPABASE_BUCKET=seed-unfold-assets

# ------------------------------------------------------------------------------
# 4. Authentication (Supabase Auth)
# ------------------------------------------------------------------------------
# Set to false in production to enforce real email verification tokens
DEV_AUTO_CONFIRM_EMAILS=false

# ------------------------------------------------------------------------------
# 5. Media Synthesis Providers (Operational Baseline)
# ------------------------------------------------------------------------------
# Image generation: Pollinations Flux (Free tier default; optional key for priority)
# POLLINATIONS_API_KEY=your_pollinations_key_here
#
# Narration: Microsoft Edge-TTS (Free, built-in neural voice synthesis)
# Audio Atmosphere: Procedural Soundscape Composer (Built-in CC0 multi-track synthesis)
# Video Generation: Currently unavailable / retired. Local Wan2.1 optional microservice:
# WAN_ENDPOINT=http://localhost:8001/generate_video

# ------------------------------------------------------------------------------
# 6. Network Security & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 7. Dedicated Cinematic Worker & Feature Flags (Milestone 7)
# ------------------------------------------------------------------------------
# [LEGACY / PHASE 51 HISTORICAL] Direct HTTP worker dispatch is deprecated.
# Phase 52 supersedes direct HTTP with Azure Storage Queue dispatch.
# CINEMATIC_WORKER_URL is preserved only for backwards-compatible local development.
CINEMATIC_WORKER_URL=http://praroha-cinematic-worker:8080
WORKER_AUTH_TOKEN=your_secure_worker_auth_token_here

# Server-Side Guard: Cinematic Preview Generation (Default: false; returns HTTP 503)
CINEMATIC_PREVIEW_ENABLED=false

# Frontend Feature Flag: Cinematic Video Generation (Default: false in production until approved)
VITE_ENABLE_CINEMATIC_PREVIEW=false

