# ==============================================================================
# Praroha / Seed Unfold Environment Configuration
# ==============================================================================

# AI Provider Selection:
# - 'mock'   : Default deterministic offline mode (no API key needed, zero-cost, instant)
# - 'gemini' : Live Google Gemini AI mode (requires GEMINI_API_KEY below)
AI_PROVIDER=gemini

# Google Gemini API Key:
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# Paste your key below and set AI_PROVIDER=gemini to enable live LLM generation:
GEMINI_API_KEY= 

# Gemini Model Selection (Default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Storage Provider: 'local' (offline ./uploads/) or 'supabase' (cloud storage)
STORAGE_PROVIDER=local

# Optional Cloud Database URL (Default: local SQLite database ./seed_unfold.db)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/seed_unfold

# Optional Supabase Cloud Object Storage (only needed if STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key
# SUPABASE_BUCKET=seed-unfold-assets
